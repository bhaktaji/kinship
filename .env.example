# Copy to .env and adjust. Never commit .env.
KINSHIP_DB_NAME=kinship
KINSHIP_DB_USER=kinship
KINSHIP_DB_PASSWORD=kinship
# At least 32 characters. Generate with: openssl rand -base64 32
KINSHIP_JWT_SECRET=replace-with-at-least-32-random-characters
KINSHIP_COOKIE_SECURE=false
KINSHIP_CORS_ORIGINS=http://localhost:3000
KINSHIP_SEED=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
